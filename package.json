{
  "name": "lexicell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort --base /absproxy/5173/",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "sim": "tsx scripts/sim.ts",
    "diag:words": "tsx scripts/word-gap.ts",
    "dict:build": "tsx scripts/build-dictionary.ts",
    "defs:build": "tsx scripts/build-definitions.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
